# ==============================================================================
# MirageDiary Environment Configuration
# ==============================================================================

# --- Telegram Bot Settings ---
# Токен бота Telegram из @BotFather
BotToken=YOUR_TELEGRAM_BOT_TOKEN_HERE

# (Опционально) Обязательный канал для подписки
Telegram__RequiredChannel=
Telegram__ChannelLink=

# --- MAX Bot Settings ---
# Токен бота MAX (если используется)
MaxBotToken=YOUR_MAX_BOT_TOKEN_HERE
MaxBotUsername=se13960436_bot

# --- Security & Encryption (152-ФЗ) ---
# 32-байтный Base64 мастер-ключ конвертного шифрования токенов AES-256-GCM
Security__TokenEncryptionKey=YOUR_32_BYTE_BASE64_KEY_HERE

# Секретный ключ для доступа к веб-админке (/admin?key=...)
Security__AdminKey=YOUR_ADMIN_SECRET_KEY_HERE

# --- URLs & Service Configuration ---
MiniAppUrl=https://miragediary.space/

# --- Database & Storage (Default: /app/data inside container) ---
# ConnectionStrings__DefaultConnection=Data Source=/app/data/miragediary.db
# MIRAGE_SQLITE_CONNECTION=Data Source=/app/data/miragediary.db

# --- Maintenance & Scheduling ---
DiarySettings__MaintenanceUntilUtc=2026-09-15T00:00:00Z
DiarySettings__NotificationsEnabled=false
DiarySettings__BackgroundTokenRefreshEnabled=false
