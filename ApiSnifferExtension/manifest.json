{
  "manifest_version": 3,
  "name": "API Sniffer & Logger",
  "version": "1.0",
  "description": "Перехватывает все API запросы и ответы на странице и выгружает их в JSON",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
